# Working directory for local runs: audio to transcribe and the transcripts
# it produces. The tool itself never requires this folder — it is a
# convention so personal recordings stay out of the repository root.
data/

# Belt and braces: even outside data/, personal recordings and transcripts
# must never end up in a public repo.
